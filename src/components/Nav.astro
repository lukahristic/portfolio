---
const { pathname } = Astro.url;

const links = [
  { label: 'Work', href: '/#proof', match: '/work', hideOnMobile: false },
  { label: 'About', href: '/about', match: '/about', hideOnMobile: false },
  { label: 'Decisions', href: '/decisions', match: '/decisions', hideOnMobile: true },
  { label: 'Résumé', href: '/resume.pdf', match: null, hideOnMobile: true },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-paper border-b border-paper-dark">
  <nav class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <a
      href="/"
      class="font-display text-base font-semibold text-ink hover:text-accent transition-colors shrink-0"
    >
      Wency
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'font-body text-sm transition-colors hover:text-accent',
            l.hideOnMobile ? 'hidden sm:inline' : '',
            l.match && pathname.startsWith(l.match) ? 'text-accent' : 'text-ink-muted',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="#contact" class="font-body text-sm text-ink hover:text-accent transition-colors">
        Let's talk →
      </a>
    </div>
  </nav>
</header>
