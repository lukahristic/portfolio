---
import BeforeAfter from './BeforeAfter.astro';
import heroOld from '../assets/spottr/hero-old.jpg';
import heroNew from '../assets/spottr/hero-new.jpg';
import onboardingOld from '../assets/spottr/onboarding-old.jpg';
import onboardingNew from '../assets/spottr/onboarding-new.jpg';

const DEMO_URL = 'https://spottr-app-beta.vercel.app';
const SITE_URL = 'https://spottrph.fit';
const REPO_URL = 'https://github.com/lukahristic/spottr';
const TESTING_URL = 'https://github.com/lukahristic/spottr/blob/main/TESTING.md';

/* The sandbox gym. Real row in the database, no coordinates set on it, no real
   members — so a stranger can run the whole flow without landing in a live
   gym's roster. Kept here as a constant because it appears twice. */
const GYM_CODE = 'ZVIU5';

const steps = [
  {
    n: '01',
    text: 'Create an account. Any email and password — there is no verification step in the way.',
  },
  {
    n: '02',
    text: 'On the empty "Your gyms" screen, tap Add gym manually and enter the code below. It is a sandbox gym with no coordinates set, so check-in works from anywhere.',
  },
  {
    n: '03',
    text: 'Pick a vibe, flip "Open to chat" on if you want, tap I\'m in. You are on the live list.',
  },
];
---
{/* Spottr's "room": the shipped app's amber accent is scoped locally here,
    leaving the portfolio's terracotta as the house accent everywhere else. */}
<section
  id="spottr"
  class="bg-paper border-t border-paper-dark"
  style="--color-accent: #D9A53B; --color-accent-warm: #E8C06A; --color-accent-faint: #F6EBD0;"
>
  <div class="max-w-4xl mx-auto px-6 py-24">

    <!-- Header -->
    <div data-reveal class="flex items-center gap-4 mb-16">
      <p class="font-body text-sm text-ink-muted uppercase tracking-widest">Case Study 01</p>
      <span class="flex-1 border-t border-paper-dark"></span>
      <span class="font-body text-xs text-accent uppercase tracking-wider">Product Thinking</span>
    </div>

    <h2 data-reveal class="font-display text-5xl md:text-6xl font-light text-ink mb-4" style="line-height: var(--leading-tight);">
      Spottr
    </h2>
    <p data-reveal data-reveal-delay="1" class="font-display text-2xl font-light text-ink-muted mb-12" style="font-style: italic;">
      A gym app that gets out of its own way.
    </p>

    {/*
      Placed before the narrative on purpose. Everything below this box is an
      argument about judgment; this box is the thing that makes the argument
      checkable. Someone with four minutes should reach it first.
    */}
    <div
      data-reveal
      class="mb-16 border border-paper-dark rounded-lg overflow-hidden"
      style="border-left-width: 3px; border-left-color: var(--color-accent);"
    >
      <div class="px-6 py-6">
        <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-3">
          You can check into it right now
        </p>
        <p class="font-body text-base text-ink mb-5" style="line-height: var(--leading-normal); max-width: 62ch;">
          The real app, exported to run in a browser — same screens, same Postgres, same
          realtime. No install. A sandbox gym is built into the database for exactly this,
          so you can run the whole flow without appearing in a real gym's roster.
        </p>

        <div class="flex flex-wrap gap-x-6 gap-y-2 mb-6">
          <a
            href={DEMO_URL}
            target="_blank"
            rel="noopener"
            class="font-body text-sm text-accent hover:text-accent-warm transition-colors"
          >
            Open the app →
          </a>
          <a
            href={SITE_URL}
            target="_blank"
            rel="noopener"
            class="font-body text-sm text-accent hover:text-accent-warm transition-colors"
          >
            The marketing site →
          </a>
        </div>

        <div class="pt-5 border-t border-paper-dark">
          <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-4">
            Two minutes, any device
          </p>

          <ol class="mb-5" style="display: grid; gap: 0.75rem;">
            {steps.map((s) => (
              <li class="flex gap-4">
                <span class="font-body text-xs text-ink-faint flex-shrink-0" style="padding-top: 0.2rem;">{s.n}</span>
                <span class="font-body text-sm text-ink-muted" style="line-height: var(--leading-normal); max-width: 58ch;">
                  {s.text}
                </span>
              </li>
            ))}
          </ol>

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-4">
            <span class="font-body text-xs text-ink-faint uppercase tracking-widest">Gym code</span>
            <span
              class="font-body text-sm text-ink bg-paper-dark px-2.5 py-1 rounded"
              style="letter-spacing: 0.12em;"
            >
              {GYM_CODE}
            </span>
            <span class="font-body text-xs text-ink-faint">Spottr Test Gym</span>
          </div>

          <p class="font-body text-sm text-ink-muted" style="line-height: var(--leading-normal); max-width: 62ch;">
            Alone in there, you get the empty state — which is the honest result, since
            presence is the product. To watch check-in, presence and the one-message intro
            work end to end, sign up as a second account in a private window and join with
            the same code.
            {' '}
            <a
              href={TESTING_URL}
              target="_blank"
              rel="noopener"
              class="text-accent hover:text-accent-warm transition-colors"
            >
              The full testing guide →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Sticky running head — pins below the title and tracks the current beat -->
    <div class="spottr-marker" aria-hidden="true">
      <span class="spottr-marker__study">01 — Spottr</span>
      <span class="spottr-marker__beat" data-beat-label>The problem</span>
    </div>

    <!-- Problem -->
    <div data-beat="The problem" class="mb-20">
      <p data-reveal class="font-body text-xs text-ink-faint uppercase tracking-widest mb-6">The problem</p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        You just joined a gym. You want to get stronger but you don't really know what you're doing.
        There's someone across the floor who clearly does. You could ask — but you don't.
        They look busy. They might be annoyed. You don't want to be <em>that person</em>.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        They see you too. They'd actually enjoy helping. But they don't want to walk up
        uninvited and give advice nobody asked for. So nothing happens.
      </p>

      <div class="quote-wrap my-10">
        <span class="quote-wrap__mark" aria-hidden="true">&rdquo;</span>
        <blockquote
          data-reveal data-reveal-delay="1"
          class="border-l-2 border-accent pl-6"
          style="border-left-color: var(--color-accent);"
        >
          <p class="font-display text-2xl font-light text-ink" style="font-style: italic; line-height: var(--leading-snug);">
            "Both sides want to connect. Neither side moves. That's the gym intimidation deadlock."
          </p>
        </blockquote>
      </div>

      <p data-reveal class="font-body text-lg text-ink" style="line-height: var(--leading-loose);">
        Most "gym buddy" apps try to solve this with profiles and matching —
        a dating-app model transplanted to the gym floor. That's the wrong diagnosis.
        The problem isn't discovery. It's <strong>permission</strong>.
      </p>
    </div>

    <!-- Insight -->
    <div data-reveal data-beat="The insight" class="mb-20 bg-paper-mid border border-paper-dark rounded-lg p-8 md:p-12">
      <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-6">The insight</p>

      <p class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        People need a signal that the other person is actually there, actually open,
        and actually expecting contact. Context does the permission work — not profiles.
      </p>

      <p class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        Spottr's solution: <strong>geolocation-gated live presence</strong> + <strong>chat-first contact</strong>.
        You only appear as "live" when you're physically checked in at the gym.
        Contact happens through the app — no approaching in person unless both people agree.
        The shared location and shared moment eliminate the awkwardness before it starts.
      </p>

      <p class="font-body text-lg text-ink" style="line-height: var(--leading-loose);">
        GPS is the gate, but it is not the only door. Location fails indoors and people deny the
        permission, so every gym has a code you can type instead. The check still means
        "you are here" — a code is only printed on the wall of the room it lets you into.
      </p>
    </div>

    <!-- Design override moment -->
    <div data-beat="The decision" class="mb-20">
      <p data-reveal class="font-body text-xs text-ink-faint uppercase tracking-widest mb-6">The decision that mattered most</p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        The first design that came back was black-and-white, high-contrast, premium-feeling.
        Clean lines. Dark mode. The kind of thing that looks impressive in a Dribbble screenshot.
      </p>

      <p data-reveal data-reveal-delay="1" class="font-display text-3xl font-light text-ink my-8" style="line-height: var(--leading-snug);">
        I rejected it.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        Not because it was bad design. Because it was <em>wrong</em> design.
        The product's entire reason to exist is reducing gym intimidation —
        and the design was intimidating. The aesthetic contradicted the soul of the app.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-10" style="line-height: var(--leading-loose);">
        I gave the AI a new brief: warm, friendly, approachable — the antithesis
        of the "serious gym" look. It generated a warm light palette. That's the version that shipped.
      </p>

      <!-- The proof: the rejected design wipes into the shipped one -->
      <BeforeAfter
        before={heroOld}
        after={heroNew}
        beforeAlt="Spottr's rejected first design — black, high-contrast, dark mode"
        afterAlt="Spottr's shipped design — warm, light, approachable"
        beforeLabel="What came back"
        afterLabel="What shipped"
      />

      <div data-reveal class="border border-accent-faint bg-accent-faint rounded-lg px-6 py-4 mt-10">
        <p class="font-body text-sm text-ink" style="line-height: var(--leading-normal);">
          <strong>The lesson isn't about taste.</strong>
          It's about knowing what the thing is <em>for</em> — and overriding the output when it misses that.
          That's not a technical skill. That's judgment.
        </p>
      </div>
    </div>

    <!-- Iteration: the status system I rebuilt around mood -->
    <div data-beat="The iteration" class="mb-20">
      <p data-reveal class="font-body text-xs text-ink-faint uppercase tracking-widest mb-6">The feature I rebuilt</p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        The first version had a status system. When you checked in, you chose one —
        Happy to Help, Need Guidance, or Just Training — so the room knew what kind of session
        you were having.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        It broke the moment I used it on myself. To set a status, you had to publicly declare
        your competence: announce you were the expert, or admit you were the one who needed help.
      </p>

      <p data-reveal data-reveal-delay="1" class="font-display text-3xl font-light text-ink my-8" style="line-height: var(--leading-snug);">
        I'd rebuilt the exact intimidation the app exists to remove.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        So I tore it out and rebuilt it around mood instead of role — Locked in, Finding my rhythm,
        Taking it easy, Quick session, In between sets, Just showing up, or a line of your own.
        None of them rank you. They just say where your head is.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        Then willingness to connect became its own, separate thing: a single <strong>Open to chat</strong>
        toggle. You can be locked in and still open to a hello, or taking it easy and left alone. Those
        were never the same question — the first design had just fused them together.
      </p>

      <p data-reveal class="font-body text-lg text-ink mb-10" style="line-height: var(--leading-loose);">
        It is off by default and it resets to off every single check-in. Under the toggle, the app
        says so: <em>"Resets every visit. Always your choice."</em> A consent setting that persists
        quietly becomes a thing you agreed to months ago and forgot — so it expires when you leave.
      </p>

      <!-- The proof: the status system wipes into the mood + toggle rebuild -->
      <BeforeAfter
        before={onboardingOld}
        after={onboardingNew}
        beforeAlt="Spottr's rejected status system — Happy to Help, Need Guidance, Just Training"
        afterAlt="Spottr's shipped mood system — Locked in, Finding my rhythm, Taking it easy, plus a welcome-a-hello toggle"
        beforeLabel="Status system"
        afterLabel="Mood + a toggle"
      />

      <div data-reveal class="border border-accent-faint bg-accent-faint rounded-lg px-6 py-4 mt-10">
        <p class="font-body text-sm text-ink" style="line-height: var(--leading-normal);">
          <strong>Same lesson, twice.</strong>
          The mechanic was never the problem — it was what it forced people to say about themselves.
          A feature can work perfectly and still carry the wrong message. Catching that before a user
          feels it is the actual job.
        </p>
      </div>
    </div>

    <!-- Build -->
    <div data-reveal data-beat="How it was built" class="mb-20">
      <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-6">How it was built</p>

      <p class="font-body text-lg text-ink mb-6" style="line-height: var(--leading-loose);">
        Built in plan mode. Every feature started as a written brief — what it should do,
        what it shouldn't do, what decisions I was making and why.
        I read the Supabase and Expo documentation before implementing, not after things broke.
        Prompts were engineered like contractor briefs: specific, constrained, with explicit constraints.
      </p>

      <p class="font-body text-lg text-ink" style="line-height: var(--leading-loose);">
        The AI handled execution. I handled direction.
      </p>
    </div>

    <!-- Architecture -->
    <div data-reveal class="mb-20">
      <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-4">Architecture</p>
      <h3 class="font-display text-2xl font-light text-ink mb-8" style="line-height: var(--leading-snug);">How it's assembled</h3>

      <div class="mb-10 border border-paper-dark rounded-lg overflow-hidden">
        <div class="arch-row" data-expanded="false" style="border-bottom: 1px solid var(--color-paper-dark);">
          <button class="arch-toggle w-full text-left px-5 py-4 flex items-center gap-4" aria-expanded="false" aria-controls="arch-detail-mobile">
            <span class="font-body text-sm font-medium text-ink flex-shrink-0" style="min-width: 6.5rem;">Mobile App</span>
            <span class="font-body text-sm text-ink-muted" style="flex: 1;">React Native · Expo · expo-router</span>
            <span class="card-expand-icon" aria-hidden="true">+</span>
          </button>
          <div class="card-expandable" id="arch-detail-mobile">
            <div class="card-inner">
              <p class="font-body text-sm text-ink-faint px-5 pb-4" style="line-height: var(--leading-normal);">Auth, onboarding, live member list, messaging, QR and gym-code check-in, push notifications. The same source exports to the browser through react-native-web — which is the demo linked at the top of this page, not a separate build</p>
            </div>
          </div>
        </div>
        <div class="arch-row" data-expanded="false" style="border-bottom: 1px solid var(--color-paper-dark);">
          <button class="arch-toggle w-full text-left px-5 py-4 flex items-center gap-4" aria-expanded="false" aria-controls="arch-detail-admin">
            <span class="font-body text-sm font-medium text-ink flex-shrink-0" style="min-width: 6.5rem;">Admin Portal</span>
            <span class="font-body text-sm text-ink-muted" style="flex: 1;">Next.js 16 · Vercel · SSR auth</span>
            <span class="card-expand-icon" aria-hidden="true">+</span>
          </button>
          <div class="card-expandable" id="arch-detail-admin">
            <div class="card-inner">
              <p class="font-body text-sm text-ink-faint px-5 pb-4" style="line-height: var(--leading-normal);">Platform HQ and gym-partner portals, server-side Supabase sessions</p>
            </div>
          </div>
        </div>
        <div class="arch-row" data-expanded="false" style="border-bottom: 1px solid var(--color-paper-dark);">
          <button class="arch-toggle w-full text-left px-5 py-4 flex items-center gap-4" aria-expanded="false" aria-controls="arch-detail-backend">
            <span class="font-body text-sm font-medium text-ink flex-shrink-0" style="min-width: 6.5rem;">Backend</span>
            <span class="font-body text-sm text-ink-muted" style="flex: 1;">Postgres · RLS · Realtime · Edge Functions · pg_cron</span>
            <span class="card-expand-icon" aria-hidden="true">+</span>
          </button>
          <div class="card-expandable" id="arch-detail-backend">
            <div class="card-inner">
              <p class="font-body text-sm text-ink-faint px-5 pb-4" style="line-height: var(--leading-normal);">JWT auth, row-level security on all tables, WebSocket live updates, Deno serverless functions, scheduled cleanup jobs</p>
            </div>
          </div>
        </div>
        <div class="arch-row" data-expanded="false">
          <button class="arch-toggle w-full text-left px-5 py-4 flex items-center gap-4" aria-expanded="false" aria-controls="arch-detail-launch">
            <span class="font-body text-sm font-medium text-ink flex-shrink-0" style="min-width: 6.5rem;">Launch surface</span>
            <span class="font-body text-sm text-ink-muted" style="flex: 1;">Next.js site · EAS Build</span>
            <span class="card-expand-icon" aria-hidden="true">+</span>
          </button>
          <div class="card-expandable" id="arch-detail-launch">
            <div class="card-inner">
              <p class="font-body text-sm text-ink-faint px-5 pb-4" style="line-height: var(--leading-normal);">Marketing site and store listing assets, with native builds produced through EAS rather than a local toolchain</p>
            </div>
          </div>
        </div>
      </div>

      <div data-reveal class="border-l-4 border-accent rounded-r-lg px-6 py-5" style="background-color: var(--color-accent-faint);">
        <p class="font-body text-xs text-accent uppercase tracking-widest mb-3">What makes it real</p>
        <p class="font-display text-lg font-light text-ink mb-4" style="line-height: var(--leading-snug);">The constraint is at the data layer.</p>
        <p class="font-body text-sm text-ink mb-4" style="line-height: var(--leading-normal);">
          Block relationships enforced by RLS — blocked users cannot see each other's check-ins,
          not because the app hides them, but because the database returns nothing.
          The one-intro limit is a UNIQUE constraint on thread pairs, held honest by a
          <code class="text-ink-muted">CHECK (user_1 &lt; user_2)</code> that stores every pair in one
          canonical order, so A→B and B→A are the same row and the second intro has nowhere to go.
        </p>
        <p class="font-body text-sm text-ink" style="line-height: var(--leading-normal);">
          The consent rule took two passes. A trigger validated who you were and whether you were
          blocked — but not whether the person you were messaging was actually open to chat, because
          the app only ever drew that button for people who were. The rule was real in the interface
          and absent from the database, so a direct API call could open a thread with anyone checked
          in. It now checks both people are checked in at the same gym, that the recipient's
          <code class="text-ink-muted">open_to_chat</code> is true, and that women-only check-ins are
          reachable only by verified women — the same test the read policy already made.
        </p>
      </div>
    </div>

    <!-- Source -->
    <div
      data-reveal
      class="mb-16 border border-paper-dark rounded-lg overflow-hidden"
      style="border-left-width: 3px; border-left-color: var(--color-accent);"
    >
      <div class="px-6 py-6">
        <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-3">
          The whole thing is readable
        </p>
        <p class="font-body text-base text-ink mb-5" style="line-height: var(--leading-normal);">
          232 commits across the app, the admin portal, the marketing site, and the
          Supabase migrations — including the RLS policies and the security audit that
          rewrote them.
        </p>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener"
          class="font-body text-sm text-accent hover:text-accent-warm transition-colors"
        >
          Read the source →
        </a>
      </div>
    </div>

    <!-- Stack + status -->
    <div data-reveal class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pt-8 border-t border-paper-dark">
      <div>
        <p class="font-body text-xs text-ink-faint uppercase tracking-widest mb-3">Stack</p>
        <div class="flex flex-wrap gap-2">
          {["React Native", "Expo", "Supabase", "Postgres", "Next.js"].map((tech) => (
            <span class="font-body text-xs text-ink-muted border border-paper-dark px-2 py-1 rounded">
              {tech}
            </span>
          ))}
        </div>
      </div>
      <div class="sm:text-right">
        <span class="font-body text-xs text-accent uppercase tracking-wider bg-accent-faint px-3 py-1 rounded-full">
          Live demo
        </span>
        <p class="font-body text-xs text-ink-faint mt-2" style="line-height: var(--leading-normal); max-width: 34ch;">
          Ran a private beta at a real gym. Paused as a company — left deployed,
          because a thing you can open beats a thing I describe.
        </p>
      </div>
    </div>

  </div>
</section>

<style>
  .arch-row[data-expanded="true"] .card-expandable {
    grid-template-rows: 1fr;
  }
  .arch-row[data-expanded="true"] .card-expand-icon {
    transform: rotate(45deg);
    color: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.arch-row').forEach((row) => {
    const toggle = row.querySelector<HTMLButtonElement>('.arch-toggle');
    toggle?.addEventListener('click', () => {
      const expanded = row.getAttribute('data-expanded') === 'true';
      row.setAttribute('data-expanded', String(!expanded));
      toggle.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>
