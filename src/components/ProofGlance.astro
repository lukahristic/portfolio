---
const projects = [
  {
    index: "01",
    name: "Spottr",
    description: "Gym community app that removes the intimidation barrier between gym-goers.",
    stack: ["React Native", "Expo", "Supabase"],
    status: "Private beta",
    statusStyle: "accent",
    href: "/work/spottr",
    note: "Read the case study",
  },
  {
    index: "02",
    name: "MotorShop",
    description: "A learning build, taken seriously: a parts store where every part knows which bikes it fits. Deployed, with a login you can use.",
    stack: ["Next.js", "TypeScript", "Prisma", "Postgres", "Docker"],
    status: "Live demo",
    statusStyle: "muted",
    href: "/work/motorshop",
    note: "Open the demo",
  },
];
---

<section id="proof" class="bg-paper-mid border-t border-paper-dark">
  <div class="max-w-4xl mx-auto px-6 py-24">

    <p data-reveal class="font-body text-sm text-ink-muted uppercase tracking-widest mb-12">
      Work
    </p>

    <div data-reveal data-reveal-delay="1" class="grid md:grid-cols-2 gap-px bg-paper-dark">
      {projects.map((p, i) => (
        <a
          href={p.href}
          class="group bg-paper-mid p-8 hover:bg-paper transition-colors"
        >
          <div class="flex items-start justify-between mb-6">
            <span class="font-body text-xs text-ink-faint">{p.index}</span>
            <span
              class:list={[
                "font-body text-xs uppercase tracking-wider px-2 py-0.5 rounded-full",
                p.statusStyle === "accent"
                  ? "bg-accent-faint text-accent"
                  : "bg-paper-dark text-ink-muted",
              ]}
            >
              {p.status}
            </span>
          </div>

          <h2 class="font-display text-3xl font-medium text-ink mb-3 group-hover:text-accent transition-colors">
            {p.name}
          </h2>

          <p class="font-body text-base text-ink-muted mb-6" style="line-height: var(--leading-normal);">
            {p.description}
          </p>

          <div class="flex flex-wrap gap-2 mb-6">
            {p.stack.map((tech) => (
              <span class="font-body text-xs text-ink-muted border border-paper-dark px-2 py-0.5 rounded">
                {tech}
              </span>
            ))}
          </div>

          <span class="font-body text-sm text-accent">{p.note} →</span>
        </a>
      ))}
    </div>

    {/*
      Kept out of the grid above on purpose. Those two are personal builds and
      promise something clickable; this one was built for a team on company
      systems and can't be linked. Grouping by kind is more honest than
      flattening them into one row.
    */}
    <div data-reveal class="mt-16">
      <div class="flex items-center gap-4 mb-6">
        <p class="font-body text-sm text-ink-muted uppercase tracking-widest">At work</p>
        <span class="flex-1 border-t border-paper-dark"></span>
      </div>

      <a
        href="/work/knowledge-exchange"
        class="group block bg-paper-mid border border-paper-dark rounded-lg p-8 hover:bg-paper transition-colors"
      >
        <div class="flex items-start justify-between gap-4 mb-6">
          <span class="font-body text-xs text-ink-faint">03</span>
          <span class="font-body text-xs uppercase tracking-wider px-2 py-0.5 rounded-full bg-paper-dark text-ink-muted">
            Handed over
          </span>
        </div>

        <h2 class="font-display text-3xl font-medium text-ink mb-3 group-hover:text-accent transition-colors">
          Knowledge Exchange Platform
        </h2>

        <p class="font-body text-base text-ink-muted mb-6" style="line-height: var(--leading-normal); max-width: 62ch;">
          An internal knowledge system for a content review team and the trainers who
          supported them. Built in my own time, then handed over with an admin portal so
          it would keep working once I was gone.
        </p>

        <div class="flex flex-wrap gap-2 mb-6">
          {["Google Apps Script", "Google Sheets", "NotebookLM"].map((tech) => (
            <span class="font-body text-xs text-ink-muted border border-paper-dark px-2 py-0.5 rounded">
              {tech}
            </span>
          ))}
        </div>

        <span class="font-body text-sm text-accent">Read the case study →</span>
        <span class="font-body text-sm text-ink-faint block mt-2">
          Company systems, confidential client — described, not linked.
        </span>
      </a>
    </div>

  </div>
</section>
